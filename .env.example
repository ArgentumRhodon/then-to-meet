# Copy to .env and fill in. Leave these unset to run ThenToMeet exactly as before: When2Meet
# links only, no accounts. These are the web app's public settings, safe to ship to the browser.

# Firebase console > Project settings > Your apps > Web app
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# --- Local emulators (npm run emulators) ---
# Points the app at the Auth and Firestore emulators instead of your Firebase project. With
# emulators the project ID can be anything, like demo-thentomeet, and the API key any text.
# PUBLIC_FIREBASE_EMULATORS=true
